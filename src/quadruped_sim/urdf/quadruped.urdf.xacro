<?xml version="1.0"?>
<!--
  四足机器人模型（12 自由度，3 DOF/腿）—— 参照 Unitree Go2 四足结构

  Go2 构型关键特征（本模型逐条对应）：
    1. 前后腿【镜像】：后腿的髋俯仰关节安装时绕 Z 轴旋转 180°（mirror=1）。
       这样四条腿可以使用完全相同的关节角，而几何上自动呈现：
         前腿：大腿向后倾、小腿向前收（"肘部朝后"，√ 形）
         后腿：大腿向前倾、小腿向后收（"膝盖朝前"， 人 形）
       支撑反力把机身向内挤，而不是向外撇 —— 抗侧滑的力学根源。
    2. 站立为弯折式姿态（hip=0.35, knee=-0.70 rad）：四条腿关节角相同，
       前后腿因镜像呈对折形态。
    3. 站立时「机身中心 -> 足端触地点」水平距离 = 0.30 m（站立半径），
       足端位于 (±0.24, ±0.18)；大腿 0.13 m + 小腿 0.13 m。

  每条腿的关节链：
    base_link -[ abduction_joint 绕X轴 ]> abduction_link
              -[ hip_joint       绕Y轴，后腿安装镜像 ]> upper_link
              -[ knee_joint      绕Y轴 ]> lower_link
              -[ foot_joint      固定  ]> foot
-->
<robot name="quadruped" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== 尺寸参数 ==================== -->
  <xacro:property name="body_l"    value="0.36"/>
  <xacro:property name="body_w"    value="0.24"/>
  <xacro:property name="body_h"    value="0.08"/>
  <xacro:property name="body_mass" value="6.0"/>

  <xacro:property name="hip_dx"  value="0.18"/>
  <xacro:property name="hip_dy"  value="0.12"/>
  <xacro:property name="foot_dx" value="0.24"/>
  <xacro:property name="foot_dy" value="0.18"/>
  <xacro:property name="abd_dx"  value="${foot_dx - hip_dx}"/>
  <xacro:property name="abd_dy"  value="${foot_dy - hip_dy}"/>

  <xacro:property name="upper_len" value="0.13"/>
  <xacro:property name="lower_len" value="0.13"/>
  <xacro:property name="leg_r"     value="0.020"/>

  <!-- Go2 式站立姿态（四条腿关节角相同，前后腿靠镜像呈现对折形态） -->
  <xacro:property name="hip_stand"  value="0.35"/>
  <xacro:property name="knee_stand" value="-0.70"/>
  <!-- 弯折站立时髋关节到足端的竖直距离：
       upper*cos(hip) + lower*cos(hip+knee) = 0.13*(cos0.35 + cos(-0.35)) ≈ 0.244 -->
  <xacro:property name="fold_drop" value="${upper_len*cos(hip_stand) + lower_len*cos(hip_stand + knee_stand)}"/>

  <!-- 足端：平底足垫（真实四足机器人靠脚掌抓地，不用球体/滚轮） -->
  <xacro:property name="foot_l"    value="0.075"/>
  <xacro:property name="foot_w"    value="0.055"/>
  <xacro:property name="foot_h"    value="0.030"/>
  <xacro:property name="leg_mass"  value="0.35"/>
  <xacro:property name="foot_mass" value="0.08"/>

  <!-- 足垫中心相对机身中心的下沉量 = 0.04(髋) + 弯折站立竖直距离 ≈ 0.284 -->
  <xacro:property name="leg_drop" value="${body_h/2 + fold_drop}"/>
  <!-- 落地时机身中心高度 = leg_drop + 足垫半高 -->
  <xacro:property name="stand_z"  value="${leg_drop + foot_h/2}"/>

  <!-- ==================== 材质 ==================== -->
  <material name="body_grey"><color rgba="0.25 0.27 0.30 1.0"/></material>
  <material name="leg_orange"><color rgba="0.90 0.45 0.10 1.0"/></material>
  <material name="foot_black"><color rgba="0.05 0.05 0.05 1.0"/></material>

  <!-- ==================== 惯性宏 ==================== -->
  <xacro:macro name="box_inertia" params="m l w h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(w*w+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(l*l+h*h)/12}" iyz="0"
               izz="${m*(l*l+w*w)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cyl_inertia" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+l*l)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+l*l)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== 机身 ==================== -->
  <link name="base_link">
    <xacro:box_inertia m="${body_mass}" l="${body_l}" w="${body_w}" h="${body_h}"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
    </collision>
  </link>

  <!-- 激光雷达安装座（机身顶部） -->
  <link name="lidar_link">
    <xacro:cyl_inertia m="0.05" r="0.03" l="0.04"/>
    <visual>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
      <material name="foot_black"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${body_h/2 + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== 单腿宏 ==================== -->
  <!-- mirror=0：前腿（肘部朝后构型）；mirror=1：后腿（髋俯仰关节安装旋转
       180°，镜像出"膝盖朝前"构型 —— 与 Unitree Go2 相同的实现手法） -->
  <xacro:macro name="leg" params="prefix sx sy mirror:=0">

    <!-- 外摆连杆：从髋挂点斜向伸到足端正上方 -->
    <link name="${prefix}_abduction_link">
      <xacro:box_inertia m="0.15" l="0.09" w="0.09" h="0.05"/>
      <visual>
        <origin xyz="${sx*abd_dx/2} ${sy*abd_dy/2} 0" rpy="0 0 0"/>
        <geometry><box size="0.09 0.09 0.05"/></geometry>
        <material name="body_grey"/>
      </visual>
      <collision>
        <origin xyz="${sx*abd_dx/2} ${sy*abd_dy/2} 0" rpy="0 0 0"/>
        <geometry><box size="0.09 0.09 0.05"/></geometry>
      </collision>
    </link>

    <!-- 外摆关节：绕 X 轴转动，腿向外张开 -->
    <joint name="${prefix}_abduction_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_abduction_link"/>
      <origin xyz="${sx*hip_dx} ${sy*hip_dy} ${-body_h/2}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.50" upper="0.50" effort="30" velocity="12"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <!-- 大腿 -->
    <link name="${prefix}_upper_link">
      <xacro:cyl_inertia m="${leg_mass}" r="${leg_r}" l="${upper_len}"/>
      <visual>
        <origin xyz="0 0 ${-upper_len/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${leg_r}" length="${upper_len}"/></geometry>
        <material name="leg_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-upper_len/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${leg_r}" length="${upper_len}"/></geometry>
      </collision>
    </link>

    <!-- 髋关节：绕 Y 轴摆动，腿前后迈。
         后腿（mirror=1）安装时绕 Z 轴旋转 180°：同样的关节角在后腿上
         自动产生镜像的几何姿态 —— 这是 Go2 构型的核心 -->
    <joint name="${prefix}_hip_joint" type="revolute">
      <parent link="${prefix}_abduction_link"/>
      <child link="${prefix}_upper_link"/>
      <origin xyz="${sx*abd_dx} ${sy*abd_dy} 0" rpy="0 0 ${mirror*3.14159}"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.20" upper="1.20" effort="30" velocity="12"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <!-- 小腿 -->
    <link name="${prefix}_lower_link">
      <xacro:cyl_inertia m="${leg_mass}" r="${leg_r}" l="${lower_len}"/>
      <visual>
        <origin xyz="0 0 ${-lower_len/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${leg_r}" length="${lower_len}"/></geometry>
        <material name="leg_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-lower_len/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${leg_r}" length="${lower_len}"/></geometry>
      </collision>
    </link>

    <!-- 膝关节：绕 Y 轴，向后折 -->
    <joint name="${prefix}_knee_joint" type="revolute">
      <parent link="${prefix}_upper_link"/>
      <child link="${prefix}_lower_link"/>
      <origin xyz="0 0 ${-upper_len}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.40" upper="0.20" effort="30" velocity="12"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <!-- 足端：平底脚垫（不是滚轮，靠摩擦抓地行走） -->
    <link name="${prefix}_foot">
      <inertial>
        <mass value="${foot_mass}"/>
        <inertia ixx="${foot_mass*(foot_w*foot_w+foot_h*foot_h)/12}" ixy="0" ixz="0"
                 iyy="${foot_mass*(foot_l*foot_l+foot_h*foot_h)/12}" iyz="0"
                 izz="${foot_mass*(foot_l*foot_l+foot_w*foot_w)/12}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="${foot_l} ${foot_w} ${foot_h}"/></geometry>
        <material name="foot_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="${foot_l} ${foot_w} ${foot_h}"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}_foot_joint" type="fixed">
      <parent link="${prefix}_lower_link"/>
      <child link="${prefix}_foot"/>
      <origin xyz="0 0 ${-lower_len}" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

  <!-- 四条腿：fl 左前 / fr 右前 / rl 左后 / rr 右后（后腿 mirror=1 镜像安装） -->
  <xacro:leg prefix="fl" sx="1"  sy="1"  mirror="0"/>
  <xacro:leg prefix="fr" sx="1"  sy="-1" mirror="0"/>
  <xacro:leg prefix="rl" sx="-1" sy="1"  mirror="1"/>
  <xacro:leg prefix="rr" sx="-1" sy="-1" mirror="1"/>

  <!-- ==================== Gazebo 关节位置控制器 ==================== -->
  <xacro:macro name="joint_pos_ctrl" params="joint topic p d">
    <gazebo>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>${joint}</joint_name>
        <topic>${topic}</topic>
        <p_gain>${p}</p_gain>
        <i_gain>0.15</i_gain>
        <d_gain>${d}</d_gain>
        <i_max>1.0</i_max>
        <i_min>-1.0</i_min>
        <cmd_max>60</cmd_max>
        <cmd_min>-60</cmd_min>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="leg_ctrls" params="prefix">
    <xacro:joint_pos_ctrl joint="${prefix}_abduction_joint" topic="/quadruped/${prefix}_abduction/cmd_pos" p="50" d="3.5"/>
    <xacro:joint_pos_ctrl joint="${prefix}_hip_joint"       topic="/quadruped/${prefix}_hip/cmd_pos"       p="50" d="3.0"/>
    <!-- 弯折站立姿态下膝关节需要撑住更大的支撑力矩，增益比直腿方案更高 -->
    <xacro:joint_pos_ctrl joint="${prefix}_knee_joint"      topic="/quadruped/${prefix}_knee/cmd_pos"      p="60" d="3.5"/>
  </xacro:macro>

  <xacro:leg_ctrls prefix="fl"/>
  <xacro:leg_ctrls prefix="fr"/>
  <xacro:leg_ctrls prefix="rl"/>
  <xacro:leg_ctrls prefix="rr"/>

  <!-- 关节状态发布 -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_publish_frequency>50</odom_publish_frequency>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_frame>odom</odom_frame>
      <dimensions>2</dimensions>
      <!-- 里程计来源：默认 ENCODER 是把各关节运动积分成车体位移，
           四足腿在空中摆动时会被算成"机器人走了很远"（实测 0.15 m 报成 4.31 m）。
           改为 WORLD 直接取仿真里的真实位姿，作为 Nav2 的地面真值里程计。 -->
      <odom_source>WORLD</odom_source>
    </plugin>
  </gazebo>

  <!-- ==================== 传感器 ==================== -->
  <gazebo reference="base_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>imu</topic>
      <gz_frame_id>base_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ==================== 前向深度相机 ==================== -->
  <link name="depth_camera_link">
    <xacro:box_inertia m="0.05" l="0.05" w="0.09" h="0.03"/>
    <visual>
      <geometry><box size="0.05 0.09 0.03"/></geometry>
      <material name="foot_black"/>
    </visual>
  </link>
  <joint name="depth_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="depth_camera_link"/>
    <origin xyz="${body_l/2 + 0.025} 0 0.01" rpy="0 0 0"/>
  </joint>

  <gazebo reference="depth_camera_link">
    <sensor name="depth_camera" type="depth_camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <topic>depth_camera</topic>
      <gz_frame_id>depth_camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- 足端摩擦，防止打滑（平底足垫需要较高摩擦系数） -->
  <gazebo reference="fl_foot"><mu1>1.5</mu1><mu2>1.5</mu2><kp>1000000</kp><kd>100</kd></gazebo>
  <gazebo reference="fr_foot"><mu1>1.5</mu1><mu2>1.5</mu2><kp>1000000</kp><kd>100</kd></gazebo>
  <gazebo reference="rl_foot"><mu1>1.5</mu1><mu2>1.5</mu2><kp>1000000</kp><kd>100</kd></gazebo>
  <gazebo reference="rr_foot"><mu1>1.5</mu1><mu2>1.5</mu2><kp>1000000</kp><kd>100</kd></gazebo>

</robot>
