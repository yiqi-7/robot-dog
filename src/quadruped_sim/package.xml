<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quadruped_sim</name>
  <version>0.1.0</version>
  <description>四足机器人仿真：xacro 模型 + Gazebo 加载 + C++ 爬行步态控制 + 仿真传感器与 SLAM/Nav2 参数。上云桥接见 quadruped_mqtt_bridge，自主导航见 quadruped_explorer。</description>
  <maintainer email="wby@example.com">wby</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- C++ 编译与运行依赖 -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <!-- 巡逻/自主导航已拆到 quadruped_explorer（rclcpp_action/nav2_msgs 随迁）；
       上云桥接已拆到 quadruped_mqtt_bridge（mosquitto/opencv/nlohmann 随迁） -->
  <build_depend>libx11-dev</build_depend>
  <exec_depend>libx11-dev</exec_depend>

  <!-- 运行时依赖 -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
