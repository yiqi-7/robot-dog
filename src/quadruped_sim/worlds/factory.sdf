<?xml version="1.0"?>
<!--
  厂区仿真世界

  围墙  : 20 m x 14 m（X 方向 20 m，Y 方向 14 m），高 2.5 m，厚 0.25 m
  货架  : 东西两侧各 4 组，箱体 1.4 x 0.5 x 1.8 m
  设备  : 四角储罐（圆柱 r=0.45, h=1.4），中部 2 个料箱（0.8 m 立方）
  出生点: 厂区中心 (0, 0) 附近保持空旷，机器人从此处生成
-->
<sdf version="1.9">
  <world name="factory">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"           name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system"               name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.70 0.75 0.80 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <!-- ==================== 地面 ==================== -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>24 18</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>24 18</size></plane></geometry>
          <material>
            <ambient>0.45 0.46 0.48 1</ambient>
            <diffuse>0.55 0.56 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 围墙 20m x 14m ==================== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 7 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.5 0.25 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.5 0.25 2.5</size></box></geometry>
          <material>
            <ambient>0.58 0.58 0.56 1</ambient>
            <diffuse>0.68 0.68 0.66 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -7 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.5 0.25 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.5 0.25 2.5</size></box></geometry>
          <material>
            <ambient>0.58 0.58 0.56 1</ambient>
            <diffuse>0.68 0.68 0.66 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>10 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.25 14 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 14 2.5</size></box></geometry>
          <material>
            <ambient>0.58 0.58 0.56 1</ambient>
            <diffuse>0.68 0.68 0.66 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-10 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.25 14 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 14 2.5</size></box></geometry>
          <material>
            <ambient>0.58 0.58 0.56 1</ambient>
            <diffuse>0.68 0.68 0.66 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 货架（box）==================== -->
    <model name="shelf_w1">
      <static>true</static>
      <pose>-7.5 -4.5 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.4 0.5 1.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.5 1.8</size></box></geometry>
          <material><ambient>0.72 0.44 0.20 1</ambient><diffuse>0.80 0.50 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_w2">
      <static>true</static>
      <pose>-7.5 -1.5 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.4 0.5 1.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.5 1.8</size></box></geometry>
          <material><ambient>0.72 0.44 0.20 1</ambient><diffuse>0.80 0.50 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_w3">
      <static>true</static>
      <pose>-7.5 1.5 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.4 0.5 1.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.5 1.8</size></box></geometry>
          <material><ambient>0.72 0.44 0.20 1</ambient><diffuse>0.80 0.50 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_w4">
      <static>true</static>
      <pose>-7.5 4.5 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.4 0.5 1.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.5 1.8</size></box></geometry>
          <material><ambient>0.72 0.44 0.20 1</ambient><diffuse>0.80 0.50 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_e1">
      <static>true</static>
      <pose>7.5 -4.5 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.4 0.5 1.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.5 1.8</size></box></geometry>
          <material><ambient>0.72 0.44 0.20 1</ambient><diffuse>0.80 0.50 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_e2">
      <static>true</static>
      <pose>7.5 -1.5 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.4 0.5 1.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.5 1.8</size></box></geometry>
          <material><ambient>0.72 0.44 0.20 1</ambient><diffuse>0.80 0.50 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_e3">
      <static>true</static>
      <pose>7.5 1.5 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.4 0.5 1.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.5 1.8</size></box></geometry>
          <material><ambient>0.72 0.44 0.20 1</ambient><diffuse>0.80 0.50 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_e4">
      <static>true</static>
      <pose>7.5 4.5 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.4 0.5 1.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.5 1.8</size></box></geometry>
          <material><ambient>0.72 0.44 0.20 1</ambient><diffuse>0.80 0.50 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== 设备（cylinder 储罐）==================== -->
    <model name="tank_nw">
      <static>true</static>
      <pose>-3.5 3.5 0.7 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.45</radius><length>1.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.45</radius><length>1.4</length></cylinder></geometry>
          <material><ambient>0.20 0.38 0.65 1</ambient><diffuse>0.25 0.45 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tank_sw">
      <static>true</static>
      <pose>-3.5 -3.5 0.7 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.45</radius><length>1.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.45</radius><length>1.4</length></cylinder></geometry>
          <material><ambient>0.20 0.38 0.65 1</ambient><diffuse>0.25 0.45 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tank_ne">
      <static>true</static>
      <pose>3.5 3.5 0.7 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.45</radius><length>1.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.45</radius><length>1.4</length></cylinder></geometry>
          <material><ambient>0.20 0.38 0.65 1</ambient><diffuse>0.25 0.45 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tank_se">
      <static>true</static>
      <pose>3.5 -3.5 0.7 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.45</radius><length>1.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.45</radius><length>1.4</length></cylinder></geometry>
          <material><ambient>0.20 0.38 0.65 1</ambient><diffuse>0.25 0.45 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== 料箱（box）==================== -->
    <model name="crate_a">
      <static>true</static>
      <pose>2.0 0 0.4 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.62 0.48 0.32 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="crate_b">
      <static>true</static>
      <pose>-2.0 0 0.4 0 0 -0.2</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.62 0.48 0.32 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
