<?xml version="1.0"?>
<!--
  厂区仿真世界（六区域布局）

  外形   : 20 m (X) x 14 m (Y)，围墙高 2.2 m、厚 0.15 m
  走廊   : 十字走廊——竖走廊 x∈[-1.3,1.3]，横走廊 y∈[-0.6,0.6]
  区域   : 车间A / 车间B / 仓库 / 充电区 / 配电室 / 中控室，各自不同颜色地面
  出生点 : (0, -5.6)，位于竖走廊南端，机头朝北（正对走廊纵深）
  说明   : 每个区域墙上有门洞通往走廊，机器人可从出生点走到任意区域
-->
<sdf version="1.9">
  <world name="factory">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"           name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system"               name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.70 0.75 0.80 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <!-- ==================== 地面 ==================== -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>24 18</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>24 18</size></plane></geometry>
          <material>
            <ambient>0.42 0.43 0.45 1</ambient>
            <diffuse>0.50 0.51 0.53 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 围墙 20m x 14m ==================== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0.000 7.000 1.100 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.500 0.150 2.200</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.500 0.150 2.200</size></box></geometry>
          <material>
            <ambient>0.578 0.578 0.561 1</ambient>
            <diffuse>0.680 0.680 0.660 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0.000 -7.000 1.100 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.500 0.150 2.200</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.500 0.150 2.200</size></box></geometry>
          <material>
            <ambient>0.578 0.578 0.561 1</ambient>
            <diffuse>0.680 0.680 0.660 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>10.000 0.000 1.100 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.150 14.000 2.200</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.150 14.000 2.200</size></box></geometry>
          <material>
            <ambient>0.578 0.578 0.561 1</ambient>
            <diffuse>0.680 0.680 0.660 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
