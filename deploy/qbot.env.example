# ===========================================================================
# 部署地址配置模板
#
# 用法：
#   cp deploy/qbot.env.example deploy/qbot.env
#   然后编辑 deploy/qbot.env 填入你自己的地址。
#
# deploy/qbot.env 已在 .gitignore 里，不会被提交；
# 本文件（.example）入库，供其他人参考字段。
#
# 所有变量也可以直接用环境变量临时覆盖，例如：
#   CLOUD_HOST=203.0.113.10 ./deploy/switch_config.sh cloud
# ===========================================================================

# 中转服务器（模式 2：机器人推流/上报到这里）
# 可以是公网 IP 或域名；模式 2 必填，模式 1 不需要
CLOUD_HOST=""

# 远端 SSH 登录用户与私钥（deploy/push_cloud_app.sh 用）
CLOUD_USER="ubuntu"
CLOUD_KEY=""

# MediaMTX 对外宣告的地址（WebRTC/WHEP 用）。
# 云主机公网 IP 经过 NAT 时，自动探测拿到的是内网地址，必须在这里显式指定，
# 否则浏览器拉流失败。一般与 CLOUD_HOST 相同。
PUBLIC_IP=""

# 端口（一般不用改）
MQTT_PORT="1883"
MQTT_WS_PORT="8083"
WHEP_PORT="8889"
DASH_PORT="8080"
RTSP_PORT="8554"
