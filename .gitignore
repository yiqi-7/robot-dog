# 编译产物
build/
install/
log/

# 运行数据：忽略目录内容，但保留目录骨架（.gitkeep）
captures/*
!captures/.gitkeep
maps/*
!maps/.gitkeep
recordings/*
!recordings/.gitkeep

# 模型缓存：piper 语音模型体积大（61MB），只入库配置文件
# 获取方式：从课程教师包（class9-backup）拷贝 zh_CN-huayan-medium.onnx 与 .onnx.json
# 到 quadruped-ops/models/piper/（modelscope 旧地址已 404）
models/piper/*.onnx
quadruped-ops/models/piper/*.onnx

# Python 缓存
__pycache__/
*.pyc

# 系统文件
.DS_Store

# 前端构建产物：npm run build 可随时重建，历史里曾反复提交 1.2MB 级 bundle
quadruped-ops/dist/

# 依赖与二进制（双保险：quadruped-ops/.gitignore 已挡一次）
node_modules/
quadruped-ops/mediamtx/mediamtx
quadruped-ops/mediamtx/mediamtx.yml

# 运行时模型目录（根目录 piper 模型 61MB，只留文档说明获取方式）
models/

# Gazebo / RViz 导出的帧与录屏
frames_*.gv
frames_*.pdf
*.ogv

# 运行时日志与临时产物
*.log
real_audio.*
video-verify/
chrome-profile*/

# 本地运行副本的备份目录
quadruped-ops/dist.bak.*/

# 看板运行副本（含 node_modules 与 290MB 模型），源码以 dashboard/ 为准
/quadruped-ops/

# 部署 / 验证过程产生的临时产物
# switch_config.sh 临时改写 launch 前留下的备份
*.rtsp.bak
# 语音网关落盘的语音片段（默认保留最近 100 条）
voice-clips/
# WHEP 验证用的 SDP 文件
offer.sdp
# push_cloud_app.sh 的云端备份包与部署版本标记
qbot-app-backup-*.tar.gz
.deployed-rev

# 防误提交：shell 引号事故产物（这类文件名不可能是真实源文件）
=?[0-9]*
[\[\]{}|^$()]*

# 真实部署地址（含服务器 IP / 私钥路径），只入库 qbot.env.example
deploy/qbot.env
