# 编译产物
build/
install/
log/

# 运行数据：忽略目录内容，但保留目录骨架（.gitkeep）
captures/*
!captures/.gitkeep
maps/*
!maps/.gitkeep
recordings/*
!recordings/.gitkeep

# 模型缓存：piper 语音模型体积大（61MB），只入库配置文件
# 获取方式：从课程教师包（class9-backup）拷贝 zh_CN-huayan-medium.onnx 与 .onnx.json
# 到 quadruped-ops/models/piper/（modelscope 旧地址已 404）
models/piper/*.onnx
quadruped-ops/models/piper/*.onnx

# Python 缓存
__pycache__/
*.pyc

# 系统文件
.DS_Store

# 前端构建产物：npm run build 可随时重建，历史里曾反复提交 1.2MB 级 bundle
quadruped-ops/dist/

# 依赖与二进制（双保险：quadruped-ops/.gitignore 已挡一次）
node_modules/
quadruped-ops/mediamtx/mediamtx
quadruped-ops/mediamtx/mediamtx.yml

# 运行时模型目录（根目录 piper 模型 61MB，只留文档说明获取方式）
models/
